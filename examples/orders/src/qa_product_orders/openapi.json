{
  "info": {
    "title": "Synthetic Orders API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/orders": {
      "get": {
        "operationId": "orders.list",
        "responses": {
          "200": {
            "description": "Observed state"
          }
        }
      },
      "post": {
        "operationId": "orders.create",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "title": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Observed state"
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "operationId": "orders.get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed state"
          }
        }
      }
    },
    "/api/orders/{id}/cancel": {
      "post": {
        "operationId": "orders.cancel",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed state"
          }
        }
      }
    }
  }
}
